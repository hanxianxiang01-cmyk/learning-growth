name: CI

on:
  pull_request:
  push:
    branches: [main]

jobs:
  governance:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm run governance:check
      - run: npm run branch:check
      - run: npm run release:check

  child-typecheck:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: package-lock.json
      - run: npm ci
      - run: npm run child:typecheck
      - name: V6 pure-module and full migration inventory checks
        run: npm run child:v6:check
      # A5 cannot be certified by V6's static gallery alone: 16 actual V6
      # domains + the opt-in React mount AST are independently tested here.
      - name: MIK-A5 isolated domain and 16 Renderer wiring contracts
        run: node scripts/check-mik-a5-review.mjs

  child-build:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        skin: [exploration-lab, healing]
    env:
      NEXT_PUBLIC_CHILD_UI_VERSION: v6
      NEXT_PUBLIC_CHILD_MATH_SKIN: ${{ matrix.skin }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: package-lock.json
      - run: npm ci
      - run: npm run child:build

  backend-tests:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: apps/learning-api
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: apps/learning-api/pyproject.toml
      - name: Install backend + test deps
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"
      - name: Run pytest (pure unit tests, no DB required)
        run: PYTHONPATH=. python -m pytest tests/ -q

  v6-ui-gallery:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: package-lock.json
      - run: npm ci
      - run: npm --workspace @learning/child-web exec -- playwright install --with-deps chromium
      - name: Start V6 preview (no live backend, no seeding)
        run: |
          npm run child:v6:preview > /tmp/v6-dev.log 2>&1 &
          for i in $(seq 1 90); do
            if curl --fail --silent http://127.0.0.1:3100/dev/v6 > /dev/null; then exit 0; fi
            sleep 2
          done
          cat /tmp/v6-dev.log
          exit 1
      - run: npm run child:v6:e2e
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: v6-gallery-browser-results
          path: apps/child-web/test-results-v6
