# Copy only the required settings into apps/child-web/.env.local.
# Never put credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_CHILD_UI_VERSION=v6
NEXT_PUBLIC_CHILD_MATH_SKIN=exploration-lab
NEXT_PUBLIC_LEARNING_API_MODE=http
NEXT_PUBLIC_LEARNING_API_BASE_URL=http://localhost:8000
# Optional: set your real child ID only for explicitly authorized live sessions.
# For QA sessions use the dedicated QA child ID from your deployment.
# NEXT_PUBLIC_DEFAULT_CHILD_ID=

# MIK-A5 16 Renderer opt-in is disabled by default (task-pinned legacy).
# QA only, e.g. NEXT_PUBLIC_MIK_RENDERER_FLAGS=ten-frame=kernel,number-line=kernel
# Do not enable globally until React/Next build, browser, HTTP/DB, L2/L3 and legacy gates pass.
