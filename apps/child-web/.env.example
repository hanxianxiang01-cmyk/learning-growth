# mock: 完全可独立运行；http: 对接 FastAPI Learning Engine
NEXT_PUBLIC_LEARNING_API_MODE=mock

# OpenAPI server root
NEXT_PUBLIC_LEARNING_API_BASE_URL=http://localhost:8000

# Session Result endpoint template.
# IMPORTANT:
# 已与当前权威 Session Result 路由对齐；通常无需覆盖。
NEXT_PUBLIC_SESSION_RESULT_PATH_TEMPLATE=/v1/learning/sessions/{session_id}/result

# V1.4 游客模式已移除 NEXT_PUBLIC_DEFAULT_CHILD_ID。
# 身份由后端 POST /v1/guest/bootstrap 现场生成并用 HttpOnly Cookie 下发，
# 前端不再持有任何「默认身份」。详见 src/config.ts 的说明。

# Built-in skin IDs: exploration-lab / healing. No child-facing skin selector.
NEXT_PUBLIC_CHILD_MATH_SKIN=exploration-lab

# Full V6 presentation is the delivery default. Set legacy explicitly to roll back.
# Rebuild/restart Next after changing NEXT_PUBLIC_* values.
NEXT_PUBLIC_CHILD_UI_VERSION=v6
