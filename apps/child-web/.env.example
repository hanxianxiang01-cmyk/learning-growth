# mock: 完全可独立运行；http: 对接 FastAPI Learning Engine
NEXT_PUBLIC_LEARNING_API_MODE=mock

# OpenAPI server root
NEXT_PUBLIC_LEARNING_API_BASE_URL=http://localhost:8000

# Session Result endpoint template.
# IMPORTANT:
# 当前本地冻结 OpenAPI v1.3 尚未包含新 Session Result 路径。
# 请在正式后端 OpenAPI 更新后，将此值改为权威接口路径。
NEXT_PUBLIC_SESSION_RESULT_PATH_TEMPLATE=/v1/learning/sessions/{session_id}/result

# Mock / local demo child UUID
NEXT_PUBLIC_DEFAULT_CHILD_ID=00000000-0000-0000-0000-000000000001

# Built-in skin. Child UI is read-only. Default: math-lab
NEXT_PUBLIC_CHILD_MATH_SKIN=math-lab
