# Learning Engine 数据库连接配置（环境变量）
# 复制为 .env 并填入真实密码（不要提交 .env 到 git）
DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DEBUG=false

# ---- 游客模式（V1.4 纯游客模式设计方案）----
# 学习数据保留期（方案 4.1「最长保留 7 天」），从最后一次有效学习活动起算。
GUEST_RETENTION_DAYS=7
# 会话有效期。与数据保留期同名同长，避免「会话还在、数据没了」的错位体验。
GUEST_SESSION_DAYS=7
# Cookie 的 Secure 属性。**本地 http 调试必须 false**——否则浏览器不保存 cookie，
# 表现为「每次刷新都变新游客」。生产 HTTPS 部署时置 true。
GUEST_COOKIE_SECURE=false
# 每日题数上限（方案 1.2 / 第五章「每天最多 30 道题」）。
GUEST_DAILY_TASK_LIMIT=30
# 每日配额与保留期换算的固定时区（方案第五章「统计时区应固定」）。用 IANA 名称。
GUEST_QUOTA_TIMEZONE=Asia/Shanghai
# 清理任务开关与间隔（方案 4.3「定时任务实际运行」）。
GUEST_CLEANUP_ENABLED=true
GUEST_CLEANUP_INTERVAL_SECONDS=3600

# 运维开关：selection-trace 与 guest/qa-session、guest/admin/cleanup* 共用。
# 生产默认 false（相关端点一律 404，不暴露存在性）；E2E / 内网需置 true。
SELECTION_TRACE_ENABLED=false